NODE_ENV=development
BOT_NAME=SkyVerse
SKYVERSE_PREFIX=.
OWNER_NUMBER=
LOG_LEVEL=info
AUTH_PATH=./sessions/whatsapp
DATABASE_PATH=./data/skyverse.sqlite
WHATSAPP_LOG_LEVEL=silent
AUTO_READ=true
AUTO_ONLINE=true
USE_PAIRING_CODE=false
PAIRING_NUMBER=
KEYRA_API_KEY=
KEYRA_BASE_URL=https://www.keyrafara.com
SAIRIHOST_BASE_URL=https://api.sairihost.com
SAIRIHOST_API_KEY=
# Enable only if you want SairiHost as a last-resort TikTok fallback; it uses API quota.
SAIRIHOST_DOWNLOADER_ENABLED=false
BERAKNEW_BASE_URL=https://api.beraknew.web.id/api
BERAKNEW_API_KEY=
YTDLP_PATH=yt-dlp
