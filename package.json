{
  "name": "skyverse",
  "version": "0.1.0",
  "description": "A modern, modular, and extensible WhatsApp bot built with Node.js and Baileys.",
  "type": "module",
  "private": true,
  "engines": {"node": ">=20.0.0"},
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "find src -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "smoke": "node src/diagnostics/smoke.js",
    "check-media-tools": "sh -c 'command -v ffmpeg >/dev/null && command -v webpmux >/dev/null'",
    "check-newsletter": "node scripts/check-baileys-newsletter-support.js"
  },
  "dependencies": {
    "@hapi/boom": "9.1.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "canvas": "3.2.3",
    "dotenv": "17.4.2",
    "node-webpmux": "3.2.1",
    "pino": "9.6.0",
    "qrcode-terminal": "0.12.0",
    "sql.js": "1.14.2"
  }
}
