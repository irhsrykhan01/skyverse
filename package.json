{
  "name": "skyverse",
  "version": "0.1.0",
  "description": "A modern, modular, and extensible WhatsApp bot built with Node.js and Baileys.",
  "type": "module",
  "private": true,
  "engines": {"node": ">=20.0.0"},
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "find src -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "smoke": "node src/diagnostics/smoke.js"
  },
  "dependencies": {
    "@hapi/boom": "9.1.3",
    "@whiskeysockets/baileys": "6.7.23",
    "dotenv": "17.4.2",
    "pino": "9.6.0",
    "qrcode-terminal": "0.12.0",
    "sql.js": "1.14.2"
  }
}
